# Required: use at least 32 random characters in real environments.
APP_JWT_SECRET=replace-with-a-long-random-secret

# Optional: creates the first administrator when both values are present.
APP_ADMIN_EMAIL=admin@yourcollege.edu
APP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_ADMIN_NAME=CampusBaazar Admin
APP_ADMIN_INSTITUTION=CampusBaazar Operations

# Optional runtime configuration.
SERVER_PORT=8081

